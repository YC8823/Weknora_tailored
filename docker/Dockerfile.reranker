FROM nvidia/cuda:12.8.0-runtime-ubuntu22.04

WORKDIR /app

RUN apt-get update && apt-get install -y python3 python3-pip && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir fastapi uvicorn transformers pydantic && \
    pip3 install --no-cache-dir "torch>=2.7" --index-url https://download.pytorch.org/whl/cu128

COPY rerank_server_demo.py .

EXPOSE 8001

CMD ["python3", "rerank_server_demo.py"]
